<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.uc3m.fintech</groupId>
    <artifactId>hazelcast-imdg-market-volume-control</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Hazelcast IMDG — Market Volume Control</name>
    <description>Hazelcast in-memory data grid demos: cluster fundamentals (TCP discovery, distributed maps, CP latches) and trading-system patterns (real-time entry listeners, end-of-day EntryProcessors).</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <hazelcast.version>5.5.0</hazelcast.version>
        <logback.version>1.5.12</logback.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hazelcast</groupId>
            <artifactId>hazelcast</artifactId>
            <version>${hazelcast.version}</version>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <!-- Part 1: cluster fundamentals -->
                    <execution>
                        <id>basic-cluster-node</id>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>es.uc3m.fintech.imdg.fundamentals.BasicClusterNode</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>coordinated-node-1</id>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>es.uc3m.fintech.imdg.fundamentals.CoordinatedClusterNode</mainClass>
                            <arguments><argument>1</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>coordinated-node-2</id>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>es.uc3m.fintech.imdg.fundamentals.CoordinatedClusterNode</mainClass>
                            <arguments><argument>2</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>coordinated-node-3</id>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>es.uc3m.fintech.imdg.fundamentals.CoordinatedClusterNode</mainClass>
                            <arguments><argument>3</argument></arguments>
                        </configuration>
                    </execution>

                    <!-- Part 2: market volume control -->
                    <execution>
                        <id>volume-monitor</id>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>es.uc3m.fintech.imdg.market.VolumeMonitor</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>order-feeder</id>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>es.uc3m.fintech.imdg.market.OrderBookFeeder</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>batch-processor</id>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>es.uc3m.fintech.imdg.market.BatchVolumeProcessor</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
